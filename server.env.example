# Mobcode companion server — production environment template.
# Copy into Render's environment settings (or a local .env you never commit).

# Port Render assigns automatically; server.js uses process.env.PORT already.
# PORT=

# OpenCode engine URL: keep the engine private (localhost) in the same container.
OPENCODE_TARGET=http://127.0.0.1:46000

# OpenCode engine password — generated by `opencode serve` at startup.
# The startup script plants it in runtime.env rather than here; this remains empty.
OPENCODE_SERVER_PASSWORD=

# OpenCode engine basic-auth username (OpenCode 2 uses "opencode")
OPENCODE_SERVER_USERNAME=opencode

# Directory the engine operates on inside the container.
OPENCODE_DIRECTORY=/data/mobcode-workspace
